#!/usr/bin/env python3
"""qnap-tsx70-fancontrol - EXPERIMENTAL chassis fan control for QNAP TS-x70 boards.

Reads the Super-I/O monitoring chip exposed by the f71882fg driver directly,
because that driver publishes its pwm* files under the platform device rather
than under /sys/class/hwmon/hwmonN.

Four explicit subcommands; no flag has an implied side effect:

    status      report discovered hardware and cached calibration (read-only)
    calibrate   HAZARDOUS - deliberately stalls a fan to find its limits
    run         continuous temperature-driven control loop
    safe-state  force every channel back to the chip's automatic mode

Safety model (docs/FAN_CONTROL.md has the full discussion):

  * the controller is resolved by driver identity and refuses to guess when
    more than one device matches;
  * channels are discovered, never assumed - the reference unit drives only
    channel 3;
  * a writer lock named after the physical controller - not after the cache
    file - prevents an interactive calibration and the service loop from
    fighting over the same registers, whatever --cache each of them was
    given. safe-state deliberately takes no lock, so it always works as an
    emergency recovery;
  * SIGTERM, SIGINT, SIGHUP and SIGQUIT are all handled before the first
    register write, so an SSH disconnect mid-calibration still fails safe;
  * every exit path - clean, signalled or crashed - forces full duty and hands
    the channels back to automatic mode, then reads the registers back to
    confirm it actually happened. That readback decides the exit status: a
    stop that cannot prove the chip took the fans back exits nonzero instead
    of reporting a clean shutdown. `safe-state --dry-run` writes nothing and
    reads nothing back, so it exits 3 - "previewed, not proven" - and never
    claims a verified handback;
  * a second stop signal cannot overrule that verdict. The safe state blocks
    stop signals while it works, and unblocking them is what delivers one that
    arrived in the meantime, so the verdict is computed, logged and recorded
    before the mask comes down and the signal is re-raised only afterwards;
  * calibration refuses to start on a hot machine, aborts if the temperature
    rises during the sweep or stops being readable at all, caps how long a fan
    may sit stopped, and treats every one of its own control writes as a hard
    gate: a duty the chip did not acknowledge aborts the sweep instead of
    being followed by a lower one;
  * a duty floor stops a corrupt or hand-edited calibration from pinning a fan
    off with no way to restart it;
  * losing the temperature input escalates to full speed and then exits
    nonzero, so systemd sees the failure instead of a silent stall;
  * refused register writes are counted per channel and per register, so a
    healthy fan answering its own commands cannot mask a dead one next to it.
"""

import argparse
import errno
import fcntl
import glob
import json
import math
import os
import re
import signal
import sys
import tempfile
import time

VERSION = "2.0.0"

STATE_DIR = "/var/lib/qnap-tsx70"
CACHE_FILE = os.path.join(STATE_DIR, "fan-calibration.json")
DEFAULT_DEVICE_GLOB = "/sys/devices/platform/f71882fg.*"

# Writer locks live under a canonical runtime root, never beside the cache.
# A lock has to mean "this chip is taken", and --cache names a file: two runs
# pointed at different cache directories drive the same PWM registers and must
# still contend. QNAP_TSX70_LOCK_DIR is a documented test seam - it reroots
# the lock tree for the suite and changes nothing on a real host, where it is
# unset - and it is deliberately not a command-line flag, because a flag is
# something an operator could use to talk themselves out of the lock.
DEFAULT_LOCK_ROOT = "/run/qnap-tsx70"
LOCK_ROOT = os.environ.get("QNAP_TSX70_LOCK_DIR") or DEFAULT_LOCK_ROOT
GLOBAL_LOCK_NAME = "fancontrol.lock"
LOCK_FILE = os.path.join(LOCK_ROOT, GLOBAL_LOCK_NAME)

PWM_MIN = 0
PWM_MAX = 255
PWM_MANUAL = 1          # pwmN_enable: manual duty cycle
PWM_AUTOMATIC = 2       # pwmN_enable: chip-internal automatic control

# Lowest duty this program will ever command while a fan is meant to be
# spinning. Calibration can measure a lower stall point, but a fan parked just
# above its own stall threshold has no margin for dust, wear or a warm day, and
# a cache claiming a very low floor must not be able to pin the fan off.
PWM_FLOOR = 64

TEMP_MIN = 30           # at or below this: minimum calibrated duty
TEMP_MAX = 70           # at or above this: full speed

# The band a CPU package sensor may plausibly report, in Celsius. Outside it
# the value is a broken sensor, a misparsed register or a unit mix-up, not a
# temperature: a running x86 package does not sit below -50 C, and above 150 C
# the machine has long since shut itself down. Deliberately wide - the job
# here is to reject nonsense, not to second-guess a hot machine, which
# CALIBRATION_ABORT_TEMP does. The control loop and the calibration sweep
# share these bounds so "a reading" means the same thing in both.
TEMP_PLAUSIBLE_MIN = -50
TEMP_PLAUSIBLE_MAX = 150
INTERVAL = 10           # seconds between control iterations
TEMP_FAILURE_LIMIT = 3  # consecutive bad temperature reads before failing safe
WRITE_FAILURE_LIMIT = 3 # consecutive failed register writes before failing safe
KICKSTART_LIMIT = 6     # consecutive failed kickstarts before giving up

# Lowest duty the descending sweep will command. Deliberately below PWM_FLOOR:
# the point of the sweep is to find where this particular fan stops, which may
# be below the duty the control loop is willing to use afterwards.
CALIBRATION_SWEEP_MIN = 55

# Calibration guards.
CALIBRATION_START_MAX_TEMP = 60  # refuse to begin above this
CALIBRATION_ABORT_TEMP = 70      # abort mid-sweep at or above this
CALIBRATION_MAX_STALL_S = 45     # longest a fan may sit at 0 RPM

SAFE_PWM = PWM_MAX      # duty applied whenever the safe state is forced

# `safe-state --dry-run` writes no register and reads none back. It is a
# preview, and a preview is not evidence about a fan, so it gets its own exit
# status rather than 0: a caller that gates a deletion on `safe-state && rm`
# must not be able to earn that `rm` by adding --dry-run.
EXIT_NOT_VERIFIED = 3

STOP_SIGNALS = (signal.SIGTERM, signal.SIGINT, signal.SIGHUP, signal.SIGQUIT)


class FanError(RuntimeError):
    """Unrecoverable condition; the caller must fail safe and exit nonzero."""


class Terminated(BaseException):
    """Raised from a signal handler so `finally` blocks still run.

    Deliberately derived from BaseException, not Exception: a stray
    `except Exception` must not be able to swallow a stop request.
    """


# Every aggregate handback this process could not prove, recorded the moment
# the verdict is known and before the stop signals are let through again.
#
# main() exits 0 on Terminated, because a signalled stop is a normal way for
# this program to end. It is not a normal way to end with a fan parked at a
# stall duty, and a second stop signal is delivered at exactly the wrong
# moment: restoring the signal mask inside safe_state() is what delivers one
# that arrived while the restore was running, and it used to unwind straight
# past the `return False` underneath it. A verdict that only exists as a
# return value cannot survive that, so it is recorded here as well, where it
# outlives whatever the signal does to the call stack.
_UNVERIFIED_HANDBACKS = []


def record_unverified_handback(detail):
    """Remember a handback this process could not prove. Never cleared by luck."""
    _UNVERIFIED_HANDBACKS.append(detail)


def handback_unverified():
    return bool(_UNVERIFIED_HANDBACKS)


def handback_detail():
    return "; ".join(_UNVERIFIED_HANDBACKS)


def reset_handback_record():
    """Start a run with an empty record. Called by main(), and by the suite."""
    del _UNVERIFIED_HANDBACKS[:]


# --------------------------------------------------------------------------
# Pure logic - no I/O, directly unit tested.
# --------------------------------------------------------------------------

def clamp_pwm(value):
    try:
        return max(PWM_MIN, min(PWM_MAX, int(value)))
    except (TypeError, ValueError):
        return SAFE_PWM


def calc_pwm(temp, min_pwm, max_pwm, temp_min=TEMP_MIN, temp_max=TEMP_MAX):
    """Linear duty curve between temp_min and temp_max, clamped at both ends."""
    min_pwm = clamp_pwm(min_pwm)
    max_pwm = clamp_pwm(max_pwm)
    if max_pwm < min_pwm:
        min_pwm, max_pwm = max_pwm, min_pwm
    if temp_max <= temp_min:
        return max_pwm
    if temp <= temp_min:
        return min_pwm
    if temp >= temp_max:
        return max_pwm
    ratio = (temp - temp_min) / float(temp_max - temp_min)
    return int(round(min_pwm + ratio * (max_pwm - min_pwm)))


def temperature_is_plausible(value):
    """True when `value` can be used as a temperature reading.

    None is "we do not know" and is never a reading. Everything else has to
    sit inside the documented TEMP_PLAUSIBLE_* band.

    The two-sided band already excludes NaN and the infinities - every
    comparison against NaN is false, so NaN fails the lower bound - but the
    non-finite case is written out anyway, because that property is subtle and
    the rewrite that loses it, `not (number <= MIN or number >= MAX)`, reads
    like a harmless refactor and lets NaN straight through.
    """
    if value is None or isinstance(value, bool):
        return False
    try:
        number = float(value)
    except (TypeError, ValueError):
        return False
    if not math.isfinite(number):
        return False
    return TEMP_PLAUSIBLE_MIN < number < TEMP_PLAUSIBLE_MAX


def natural_key(path):
    """Sort hwmon2 before hwmon10.

    Plain lexicographic ordering puts hwmon10 first, which makes "the first
    matching sensor" depend on how many sensors the machine happens to have.
    """
    return [int(part) if part.isdigit() else part
            for part in re.split(r"(\d+)", path)]


def validate_cache(data):
    """Return a normalised calibration dict, or raise FanError.

    Anything that reaches a PWM register passes through here, so a corrupt,
    truncated or hand-edited cache cannot drive a fan below PWM_FLOOR.
    """
    if not isinstance(data, dict):
        raise FanError("calibration cache is not a JSON object")
    raw_channels = data.get("channels")
    if not isinstance(raw_channels, list) or not raw_channels:
        raise FanError("calibration cache has no channels")
    channels = []
    for item in raw_channels:
        try:
            channels.append(int(item))
        except (TypeError, ValueError):
            raise FanError("calibration cache has a non-numeric channel: %r"
                           % (item,))
    fans = {}
    raw_fans = data.get("fans") if isinstance(data.get("fans"), dict) else {}
    for channel in channels:
        entry = raw_fans.get(str(channel)) or raw_fans.get(channel) or {}
        if not isinstance(entry, dict):
            entry = {}
        minstop = max(PWM_FLOOR, clamp_pwm(entry.get("minstop", SAFE_PWM)))
        minstart = max(PWM_FLOOR, clamp_pwm(entry.get("minstart", SAFE_PWM)))
        fans[channel] = {
            "minstop": minstop,
            # The restart threshold is measured while ramping up and is the
            # authoritative "will it spin from standstill" value, so it can
            # never sit below the descending stall measurement.
            "minstart": max(minstart, minstop),
            "min_rpm": entry.get("min_rpm"),
            "max_rpm": entry.get("max_rpm"),
        }
    return {"channels": sorted(set(channels)), "fans": fans,
            "version": data.get("version", 1)}


def calibration_is_degenerate(result):
    """True when a calibration sweep produced values that must not be trusted.

    The usual cause is a fan that was already stopped, or a tachometer that
    never reported motion: the sweep then "finds" a stall point at the very
    first step and the numbers describe nothing real.
    """
    if not result:
        return True
    if not result.get("max_rpm"):
        return True
    if result.get("stall_duty") is None:
        return True
    if clamp_pwm(result.get("minstop")) >= PWM_MAX:
        return True
    if not result.get("min_rpm"):
        return True
    return False


# --------------------------------------------------------------------------
# sysfs access
# --------------------------------------------------------------------------

def read_sysfs(path):
    # Narrow except on purpose: a bare except here would swallow Terminated.
    try:
        with open(path, encoding="ascii", errors="replace") as fh:
            return fh.read().strip()
    except OSError:
        return None


def read_int(path):
    value = read_sysfs(path)
    try:
        return int(value)
    except (TypeError, ValueError):
        return None


def write_sysfs(path, value):
    """Write a sysfs attribute. Returns True on success, False otherwise."""
    try:
        with open(path, "w", encoding="ascii") as fh:
            fh.write(str(value))
        return True
    except OSError as exc:
        log("WARN cannot write %s=%s: %s" % (path, value, exc.strerror or exc))
        return False


def log(message):
    """Unbuffered stdout so journald shows messages as they happen.

    Python block-buffers stdout when it is a pipe, which is exactly the case
    under systemd - without the flush the journal stays empty during the run
    that matters.
    """
    print(message, flush=True)


def find_device(pattern=DEFAULT_DEVICE_GLOB):
    """Resolve the Super-I/O platform device.

    Zero matches means the driver is not loaded. More than one means the host
    exposes several instances and picking one would be a guess, so both are
    refused rather than resolved arbitrarily.
    """
    matches = sorted((p for p in glob.glob(pattern) if os.path.isdir(p)),
                     key=natural_key)
    if not matches:
        raise FanError(
            "no fan controller matched %s - is the f71882fg module loaded? "
            "(modprobe f71882fg)" % pattern)
    if len(matches) > 1:
        raise FanError(
            "ambiguous fan controller: %d devices match %s (%s); refusing to "
            "guess. Pass --device-glob to name one." % (len(matches), pattern,
                                                        ", ".join(matches)))
    return matches[0]


def find_temp_input(sensor="coretemp"):
    """Locate the CPU package temperature input by driver name, not by index."""
    for hwmon in sorted(glob.glob("/sys/class/hwmon/hwmon*"), key=natural_key):
        if read_sysfs(os.path.join(hwmon, "name")) != sensor:
            continue
        candidates = [os.path.join(hwmon, "temp1_input")]
        candidates += sorted(glob.glob(os.path.join(hwmon, "temp*_input")),
                             key=natural_key)
        for candidate in candidates:
            if os.path.exists(candidate):
                return candidate
    return None


def read_temp(path):
    """CPU temperature in Celsius, or None when unreadable or implausible.

    None means "unknown" and must stay distinguishable from a real reading;
    substituting a comfortable default here is what let the original version
    keep a fan slow while it had no idea how hot the machine was.
    """
    if not path:
        return None
    raw = read_int(path)
    if raw is None:
        return None
    celsius = raw // 1000
    if not temperature_is_plausible(celsius):
        return None
    return celsius


def controller_identity(device):
    """A stable, filesystem-safe name for one physical controller.

    The platform device's own directory name - `f71882fg.2592` - is what the
    kernel calls the chip, so it is what the lock is named after. Anything
    outside a conservative character set becomes an underscore, so a device
    path can never escape the lock root or collide with a control character.

    Returns "" when there is no usable identity, which is the caller's signal
    to fall back to the global lock rather than to invent a name.
    """
    name = os.path.basename(os.path.normpath(device or ""))
    if name in ("", ".", "..", os.sep):
        return ""
    sanitised = re.sub(r"[^A-Za-z0-9._-]", "_", name)
    # A name that is only dots would still resolve to a directory entry.
    return "" if sanitised.strip(".") == "" else sanitised


def writer_lock_paths(device=None, root=None):
    """Every lock a fan writer must hold, in the order it must take them.

    Two locks, always in this order, so they cannot deadlock:

      1. the canonical global lock. Every writer takes it, whatever device it
         resolved and whatever --cache it was given. A process that cannot
         name its controller - because discovery has not run or failed - can
         therefore still not race one that can, which a purely per-controller
         scheme would have allowed.
      2. the per-controller lock, named after the chip. This is the primary
         one: it is what makes "the same controller" the thing runs contend
         over, and it keeps the name meaningful on a host with more than one.

    Holding both means two different controllers serialise against each other
    as well. That costs nothing today - find_device() refuses to resolve an
    ambiguous controller, so this program never drives two at once - and it is
    the direction to be wrong in.
    """
    base = LOCK_ROOT if root is None else root
    paths = [os.path.join(base, GLOBAL_LOCK_NAME)]
    identity = controller_identity(device)
    if identity:
        paths.append(os.path.join(base, "fancontrol-%s.lock" % identity))
    return paths


def acquire_lock(path=LOCK_FILE):
    """Exclusive advisory lock shared by run and calibrate.

    Without it an operator running `calibrate` while the service is running
    would have two writers on the same PWM registers.
    """
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        handle = open(path, "w", encoding="ascii")  # noqa: SIM115 - held process-long
    except OSError as exc:
        raise FanError("cannot open lock file %s: %s" % (path, exc))
    try:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        handle.close()
        raise FanError(
            "another qnap-tsx70-fancontrol instance holds %s. Stop the service "
            "first: systemctl stop qnap-tsx70-fancontrol" % path)
    try:
        handle.write("%d\n" % os.getpid())
        handle.flush()
    except OSError:
        pass
    return handle


def acquire_writer_locks(device=None, root=None):
    """Take every writer lock, outermost first, or release what was taken.

    A half-held set would leave the global lock owned by a process that then
    exits without ever writing a register, which is exactly the stall the
    lock exists to avoid.
    """
    handles = []
    try:
        for path in writer_lock_paths(device, root):
            handles.append(acquire_lock(path))
    except BaseException:
        release_locks(handles)
        raise
    return handles


def release_locks(handles):
    """Drop writer locks innermost first. Never raises: called from `finally`."""
    for handle in reversed(list(handles or ())):
        try:
            handle.close()
        except OSError:
            pass


class FanController:
    """Owns every register write and knows how to put the chip back."""

    def __init__(self, device, dry_run=False):
        self.device = device
        self.dry_run = dry_run
        self._original = {}
        # A stop signal that safe_state() caught while it was establishing its
        # verdict, kept for the command to re-raise once nothing else is
        # unwinding. See safe_state() and finish_or_stop().
        self.deferred_stop = None
        # {(channel, register): consecutive failures}. Never a single number:
        # see _record_write.
        self._write_failures = {}

    # -- paths -------------------------------------------------------------
    def _path(self, name):
        return os.path.join(self.device, name)

    # -- discovery ---------------------------------------------------------
    def channels(self):
        """All channel numbers the chip exposes a tachometer for."""
        found = []
        for path in glob.glob(self._path("fan*_input")):
            num = os.path.basename(path)[len("fan"):-len("_input")]
            if num.isdigit():
                found.append(int(num))
        return sorted(found)

    def rpm(self, channel):
        return read_int(self._path("fan%d_input" % channel)) or 0

    def pwm(self, channel):
        return read_int(self._path("pwm%d" % channel))

    def enable_mode(self, channel):
        return read_int(self._path("pwm%d_enable" % channel))

    def controllable(self, channel):
        """A channel is only usable when both duty registers exist and write."""
        for name in ("pwm%d" % channel, "pwm%d_enable" % channel):
            path = self._path(name)
            if not os.path.exists(path):
                return False
            if not os.access(path, os.W_OK):
                return False
        return True

    def detect_active(self, probe=False, settle=4.0):
        """Channels with a fan attached.

        Passive detection only reads tachometers. `probe` additionally spins up
        silent channels, which changes hardware state and is therefore opt-in
        and never used by `run`.
        """
        active = []
        for channel in self.channels():
            if self.rpm(channel) > 0:
                active.append(channel)
                continue
            if not probe or not self.controllable(channel):
                continue
            with self.borrowed(channel):
                # A probe the chip did not acknowledge says nothing about
                # whether a fan is attached, and "silent" must not become
                # "calibrate it" on the strength of a command that never
                # landed.
                if not (self.set_manual(channel)
                        and self.set_pwm(channel, PWM_MAX)):
                    log("WARN channel %d did not accept the probe; not "
                        "treating it as active" % channel)
                    continue
                time.sleep(settle)
                if self.rpm(channel) > 0:
                    active.append(channel)
        return sorted(active)

    # -- register state ----------------------------------------------------
    def remember(self, channel):
        """Snapshot a channel's registers once, before the first write."""
        if channel in self._original:
            return
        self._original[channel] = {
            "pwm": self.pwm(channel),
            "enable": self.enable_mode(channel),
        }

    def _record_write(self, channel, register, ok):
        """Count consecutive write failures per channel and per register.

        This used to be one number for the whole chip, and any successful
        write reset it. On a multi-channel board that is the wrong shape: a
        fan whose duty register had stopped accepting anything at all never
        reached the limit, because the healthy channel next to it answered its
        own command every iteration and zeroed the count. The dead channel was
        then held at whatever duty it happened to be on, silently, forever.

        A success may only clear its own history, so "three refusals in a row
        on pwm1" stays true no matter how well pwm3 is doing.
        """
        key = (channel, register)
        if ok:
            self._write_failures[key] = 0
        else:
            self._write_failures[key] = self._write_failures.get(key, 0) + 1
        return ok

    def failure_count(self, channel, register):
        """Consecutive failed writes on exactly one register of one channel."""
        return self._write_failures.get((channel, register), 0)

    def exhausted_writes(self, limit=WRITE_FAILURE_LIMIT):
        """[(channel, register, count)] for every register at or over `limit`.

        Any single entry is enough to fail safe: a channel nobody can command
        is a fan nobody is in charge of, whatever the others are doing.
        """
        return sorted((channel, register, count)
                      for (channel, register), count
                      in self._write_failures.items() if count >= limit)

    def set_manual(self, channel):
        self.remember(channel)
        if self.dry_run:
            return True
        register = "pwm%d_enable" % channel
        ok = write_sysfs(self._path(register), PWM_MANUAL)
        time.sleep(0.2)
        return self._record_write(channel, register, ok)

    def set_auto(self, channel):
        if self.dry_run:
            return True
        register = "pwm%d_enable" % channel
        return self._record_write(
            channel, register,
            write_sysfs(self._path(register), PWM_AUTOMATIC))

    def set_pwm(self, channel, value):
        self.remember(channel)
        if self.dry_run:
            return True
        register = "pwm%d" % channel
        return self._record_write(
            channel, register,
            write_sysfs(self._path(register), clamp_pwm(value)))

    def restore(self, channel):
        """Return one channel to exactly the state observed before this run.

        True only when the mode register reads back as the mode that was asked
        for. The verdict is deliberately not the last word - the aggregate
        safe_state() around every hardware-mutating command is, and it covers
        this channel because borrowing one remembers it - but a restore that
        did not land is the first sign of a chip that will not take the fans
        back, and this used to report nothing at all. A probe that spun a
        channel up and could not put it down again looked exactly like one
        that had never run.
        """
        original = self._original.get(channel)
        if original is None or self.dry_run:
            return True
        wrote_duty = True
        target = original.get("pwm")
        if target is not None:
            wrote_duty = write_sysfs(self._path("pwm%d" % channel),
                                     clamp_pwm(target))
            if original.get("enable") == PWM_MANUAL and clamp_pwm(target) < PWM_FLOOR:
                log("WARN channel %d was already in manual mode below the duty "
                    "floor (%s); restoring it as found" % (channel, target))
        mode = original.get("enable")
        mode = PWM_AUTOMATIC if mode is None else mode
        wrote_mode = write_sysfs(self._path("pwm%d_enable" % channel), mode)
        readback = self.enable_mode(channel)
        if wrote_duty and wrote_mode and readback == mode:
            return True
        log("WARN channel %d was not proven back in the state it was found in "
            "(duty %s, mode %s, reads back as %s); the safe state on the way "
            "out is what has to prove it"
            % (channel, "ok" if wrote_duty else "failed",
               "ok" if wrote_mode else "failed",
               "unreadable" if readback is None else readback))
        return False

    def touched_channels(self):
        """Channels whose registers were snapshotted, so possibly written."""
        return sorted(self._original)

    def _restore_one(self, channel):
        """Put one channel back and prove it. True only when proven.

        The proof is the `pwmN_enable` readback, and it has to be exactly
        PWM_AUTOMATIC. "Unreadable" is not a pass: this used to accept None
        alongside PWM_AUTOMATIC, so a channel whose registers had stopped
        answering - the one case where a fan is most likely to be parked at a
        stall duty with nobody in charge - was logged as "-> automatic mode".

        A write that reports failure fails the channel even when the readback
        happens to say automatic. The two answers come from the same register
        interface: if it is refusing writes, its reads are not evidence either.
        """
        wrote_duty = write_sysfs(self._path("pwm%d" % channel), SAFE_PWM)
        wrote_mode = write_sysfs(self._path("pwm%d_enable" % channel),
                                 PWM_AUTOMATIC)
        mode = self.enable_mode(channel)
        if not (wrote_duty and wrote_mode):
            log("ALERT channel %d did not accept the safe-state write "
                "(duty %s, mode %s); it reads back as %s"
                % (channel, "ok" if wrote_duty else "failed",
                   "ok" if wrote_mode else "failed",
                   "unreadable" if mode is None else mode))
            return False
        if mode != PWM_AUTOMATIC:
            log("ALERT channel %d is %s after the safe state, not automatic "
                "mode (%d); check the fan manually"
                % (channel,
                   "unreadable" if mode is None else "still in mode %d" % mode,
                   PWM_AUTOMATIC))
            return False
        log("  channel %d -> automatic mode (verified)" % channel)
        return True

    @staticmethod
    def _unmask_stop_signals(blocked):
        """Put the signal mask back without letting a pending stop escape.

        SIG_SETMASK delivers every stop signal that arrived while the restore
        was running, and this program's handler turns each one into
        Terminated. Raised from here it unwinds straight out of safe_state(),
        past the aggregate verdict, and main() then reports a signalled stop -
        exit 0 - for a chip that may still be in manual mode. The signal is
        not discarded: it is handed back to the caller, which decides what it
        means once the verdict is settled.

        The loop drains them. Each pending signal is delivered once and the
        call is idempotent after the mask is back, so repeating it turns a
        queue of stop signals into a queue of returns instead of leaving one
        to surface at an arbitrary later bytecode. It is bounded by the number
        of signals that can be queued this way.
        """
        if blocked is None:
            return None
        deferred = None
        for _ in range(len(STOP_SIGNALS) + 1):
            try:
                signal.pthread_sigmask(signal.SIG_SETMASK, blocked)
                break
            except Terminated as exc:
                if deferred is None:
                    deferred = exc
            except (OSError, ValueError):
                break
        return deferred

    def safe_state(self, channels=None, reason=""):
        """Force touched channels to full duty and chip-managed automatic mode.

        Returns True only when every target channel was proven to be back in
        automatic mode. No target at all is False, not a vacuous success: the
        caller asked for a fan to be handed back and none was.

        Called from `finally` blocks and after signals, so it must never raise
        and must not be interruptible half way: stop signals are blocked for
        its duration, otherwise a second Ctrl-C could abandon the restore with
        some channels still parked at a stall duty.

        The verdict is computed, logged and recorded while they are still
        blocked, and a stop signal delivered by the unmasking is returned
        through `deferred_stop` rather than raised. Restoring the mask inside
        a `finally` and evaluating the result after it meant a second SIGTERM
        was delivered in the gap: `safe-state`, a stopping `run` and a
        finishing `calibrate` all exited 0 on a chip they had just failed to
        hand the fans back on, because main() saw only the signal.
        """
        targets = sorted(self._original) if channels is None else sorted(channels)
        if reason:
            log("SAFE-STATE %s" % reason)
        if not targets:
            log("ALERT safe state had no channel to restore; automatic mode "
                "was not verified on anything")
            record_unverified_handback("no channel to restore on %s"
                                       % self.device)
            return False
        if self.dry_run:
            log("SAFE-STATE dry run: channels %s left untouched" % targets)
            return True
        try:
            blocked = signal.pthread_sigmask(signal.SIG_BLOCK, STOP_SIGNALS)
        except (OSError, ValueError, AttributeError):
            blocked = None
        failed = []
        deferred = None
        for channel in targets:
            # Every channel is attempted whatever the ones before it did:
            # giving up on the first failure would leave the rest parked at
            # whatever duty the interrupted run had them on.
            proven = False
            # Twice at most. A signal that arrived just before the mask went
            # up has already set Python's pending flag, so its handler still
            # fires in here; abandoning the channel on it would park a fan on
            # the strength of a signal that changed nothing about the chip. A
            # second interruption is taken as a refusal, so a signal storm
            # cannot spin here.
            for _ in range(2):
                try:
                    proven = self._restore_one(channel)
                    break
                except Terminated as exc:
                    if deferred is None:
                        deferred = exc
                    log("WARN the safe state on channel %d was interrupted by "
                        "%s; trying it again before the verdict"
                        % (channel, exc))
                except Exception as exc:  # noqa: BLE001 - last line of defence
                    log("WARN safe state failed on channel %d: %s"
                        % (channel, exc))
                    break
            if not proven:
                failed.append(channel)
        if failed:
            log("ALERT %d of %d channels could not be confirmed back in "
                "automatic mode: %s" % (len(failed), len(targets), failed))
            record_unverified_handback("channels %s on %s"
                                       % (failed, self.device))
        # Only here, with the verdict computed, logged and recorded, may the
        # stop signals through again.
        pending = self._unmask_stop_signals(blocked)
        if deferred is None:
            deferred = pending
        if deferred is not None:
            if self.deferred_stop is None:
                self.deferred_stop = deferred
            if failed:
                log("ALERT %s arrived during the safe state; it does not turn "
                    "an unverified handback into a clean stop" % deferred)
        return not failed

    class _Borrowed:
        def __init__(self, controller, channel):
            self.controller = controller
            self.channel = channel

        def __enter__(self):
            self.controller.remember(self.channel)
            return self.controller

        def __exit__(self, exc_type, exc, tb):
            if exc_type is not None and issubclass(exc_type, (Terminated, FanError)):
                self.controller.safe_state([self.channel],
                                           reason="probe interrupted")
            elif not self.controller.restore(self.channel):
                # Not fatal here on purpose: every command that borrows a
                # channel does so inside an aggregate safe_state() scope that
                # covers it, and that verdict is the one the exit status is
                # built on. What must not happen is this passing in silence,
                # which is what an unchecked restore() did.
                log("WARN channel %d was borrowed and not proven back; the "
                    "safe state on the way out has to prove it" % self.channel)
            return False

    def borrowed(self, channel):
        """Context manager restoring a channel however the block exits."""
        return FanController._Borrowed(self, channel)


# --------------------------------------------------------------------------
# Calibration cache
# --------------------------------------------------------------------------

def load_cache(path=CACHE_FILE):
    try:
        with open(path, encoding="utf-8") as fh:
            return validate_cache(json.load(fh))
    except FileNotFoundError:
        return None
    except (OSError, ValueError) as exc:
        raise FanError("cannot read calibration cache %s: %s" % (path, exc))


def save_cache(data, path=CACHE_FILE):
    """Atomic write so an interrupted save cannot leave a truncated cache."""
    directory = os.path.dirname(path) or "."
    try:
        os.makedirs(directory, exist_ok=True)
    except OSError as exc:
        raise FanError("cannot create %s: %s" % (directory, exc))
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".fan-calibration.")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(data, fh, indent=2, sort_keys=True)
            fh.write("\n")
            fh.flush()
            os.fsync(fh.fileno())
        os.chmod(tmp, 0o644)
        os.replace(tmp, path)
    except OSError as exc:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise FanError("cannot write %s: %s" % (path, exc))


# --------------------------------------------------------------------------
# Subcommands
# --------------------------------------------------------------------------

CALIBRATION_WARNING = """
+----------------------------------------------------------------------+
|  WARNING - calibration deliberately stops the chassis fan.            |
|                                                                      |
|  To find the stall and restart duty cycles this procedure lowers the  |
|  fan until it STOPS SPINNING, leaving the machine with reduced or no  |
|  airflow for up to %2d seconds at a time.                              |
|                                                                      |
|  Do not run it under sustained CPU or disk load, do not walk away,    |
|  and be ready to power the machine off.                               |
|                                                                      |
|  Interrupting is safe: SIGTERM, SIGINT (Ctrl-C), SIGHUP (closing an   |
|  SSH session) and SIGQUIT all force full duty and hand the fans back  |
|  to the controller's automatic mode before exiting.                   |
+----------------------------------------------------------------------+
""" % CALIBRATION_MAX_STALL_S


def require_root():
    if os.geteuid() != 0:
        raise FanError("root privileges are required to write fan registers")


def finish_or_stop(controller, code):
    """Return `code`, unless the safe state deferred a stop signal.

    safe_state() catches the signal its own unmasking delivers instead of
    letting it unwind past the verdict, and it is called from `finally`
    blocks, where re-raising would replace whatever exception brought the
    command down and hide it. Here the verdict is settled and nothing else is
    unwinding, so the signal can finally do what a stop signal does: main()
    logs it and exits 0 - and only because the handback above was proven,
    since main() consults the record before believing any of that.
    """
    if controller.deferred_stop is not None:
        raise controller.deferred_stop
    return code


def install_signal_handlers():
    """Install stop handlers. Must run before the first register write."""
    def handler(signum, _frame):
        raise Terminated("signal %s" % signal.Signals(signum).name)
    for sig in STOP_SIGNALS:
        signal.signal(sig, handler)


def cmd_status(args):
    """Read-only. Never writes a register, so it needs no root and no lock."""
    report = {"version": VERSION, "device": None, "temperature_c": None,
              "channels": {}, "cache": None, "cache_path": args.cache}
    try:
        device = find_device(args.device_glob)
        report["device"] = device
    except FanError as exc:
        report["error"] = str(exc)
        device = None

    report["temperature_c"] = read_temp(find_temp_input(args.sensor))
    if device:
        controller = FanController(device)
        for channel in controller.channels():
            report["channels"][str(channel)] = {
                "rpm": controller.rpm(channel),
                "pwm": controller.pwm(channel),
                "enable": controller.enable_mode(channel),
                "controllable": controller.controllable(channel),
            }
        report["active_channels"] = controller.detect_active(probe=False)
    try:
        report["cache"] = load_cache(args.cache)
    except FanError as exc:
        report["cache_error"] = str(exc)

    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
        return 0 if report.get("device") else 1

    log("qnap-tsx70-fancontrol %s" % VERSION)
    log("controller : %s" % (report["device"] or report.get("error")))
    log("temperature: %s" % (("%d C" % report["temperature_c"])
                             if report["temperature_c"] is not None
                             else "N/A (sensor '%s' not found)" % args.sensor))
    if report["channels"]:
        log("channels   :")
        for channel, data in sorted(report["channels"].items(),
                                    key=lambda kv: natural_key(kv[0])):
            log("  fan%s  %5s RPM  pwm=%-4s enable=%-4s controllable=%s"
                % (channel, data["rpm"], data["pwm"], data["enable"],
                   data["controllable"]))
        log("active     : %s" % (report.get("active_channels") or "none"))
    cache = report.get("cache")
    if cache:
        log("calibration: %s (channels %s)" % (args.cache, cache["channels"]))
        for channel, data in sorted(cache["fans"].items()):
            log("  fan%s  minstop=%s minstart=%s rpm=%s-%s"
                % (channel, data["minstop"], data["minstart"],
                   data["min_rpm"], data["max_rpm"]))
    else:
        log("calibration: none at %s%s"
            % (args.cache, " (%s)" % report["cache_error"]
               if report.get("cache_error") else ""))
    return 0 if report.get("device") else 1


def cmd_safe_state(args):
    """Force every channel to automatic mode, and prove it.

    Used as ExecStopPost so that a SIGKILL, an OOM kill or a crashed
    interpreter still ends with the chip back in charge of the fans, and by
    scripts/install.sh and scripts/uninstall.sh as the gate in front of every
    removal of a fan recovery artifact. All of them read the exit status as
    "the fans are demonstrably back under the chip", so it is nonzero unless
    every controllable channel was written and read back as automatic.

    Deliberately takes no lock: this is the emergency recovery, and an
    emergency recovery that can be blocked by the thing it is recovering from
    is not one. It can therefore fight a running control loop over the same
    registers - stop the service first unless this really is a recovery.
    """
    require_root()
    device = find_device(args.device_glob)
    controller = FanController(device, dry_run=args.dry_run)
    channels = [c for c in controller.channels() if controller.controllable(c)]
    if not channels:
        # Nothing to restore is not the same as nothing to worry about: a chip
        # that exposes no writable duty register is one this program cannot
        # hand the fans back on, so it must not report that it did.
        log("ERROR no controllable channel on %s; automatic fan mode could "
            "not be verified" % device)
        return 1
    if args.dry_run:
        # A dry run writes no register and reads none back. It therefore knows
        # nothing about where the fans are, and saying so is the whole job
        # here: this command's exit status is what scripts/install.sh,
        # scripts/uninstall.sh and the documented manual procedures gate a
        # `rm` on. Exiting 0 after proving nothing would hand every one of
        # them a way to delete the fan binary by adding a flag.
        log("dry run: would write duty %d and mode %d to channels %s on %s"
            % (SAFE_PWM, PWM_AUTOMATIC, channels, device))
        log("no register was written and none was read back, so nothing was "
            "proven about the fans")
        log("exit status %d means previewed-only; only exit 0 is a handback "
            "you may delete a fan binary on" % EXIT_NOT_VERIFIED)
        return EXIT_NOT_VERIFIED
    # No prior snapshot exists in this process, so name the channels directly.
    for channel in channels:
        controller.remember(channel)
    if not controller.safe_state(channels, reason="requested via safe-state"):
        log("ERROR automatic fan mode could not be verified on %s" % device)
        return 1
    log("automatic fan mode verified on channels %s" % channels)
    return finish_or_stop(controller, 0)


def cmd_validate_cache(args):
    """Say whether a calibration cache is usable. Read-only, no hardware.

    The installer needs this verdict before it may enable the service or
    delete a legacy cache, and the schema must not be re-implemented in shell
    for it. Exits 0 when the cache validates, 1 when it does not.
    """
    path = args.cache
    if not os.path.exists(path):
        log("no calibration cache at %s" % path)
        return 1
    try:
        with open(path, encoding="utf-8") as handle:
            cache = validate_cache(json.load(handle))
    except (OSError, ValueError, FanError) as exc:
        log("calibration cache %s is not usable: %s" % (path, exc))
        return 1
    log("calibration cache %s is valid (channels %s)"
        % (path, cache["channels"]))
    return 0


def _settle(controller, channel, seconds, temp_path, stall_started=None):
    """Wait, while watching for an overheat, a lost sensor or a long stall.

    Sleeping in short slices keeps the abort responsive; a plain time.sleep()
    would happily sit through a thermal excursion with the fan stopped.

    Every sample is validated, not just the ones that arrive. The sweep below
    lowers the duty until the fan stops, so the reading is the only thing
    standing between "measuring the stall point" and "holding a stopped fan on
    a machine nobody is watching the temperature of". A sample that is missing,
    unparseable, NaN, infinite or outside the documented plausible band ends
    the calibration immediately: there is no safe way to take the next step
    down blind, and a retry loop would be more time at the current duty.
    """
    # A dry run writes no register, so there is no duty being lowered and no
    # reason to demand a sensor from a host that may not have one. This is the
    # only case cmd_calibrate lets through without a temperature input.
    watching = not (controller.dry_run and temp_path is None)
    deadline = time.monotonic() + seconds
    while time.monotonic() < deadline:
        time.sleep(min(0.5, max(0.05, deadline - time.monotonic())))
        temp = read_temp(temp_path) if watching else None
        if watching and not temperature_is_plausible(temp):
            raise FanError(
                "aborting calibration: the temperature sensor stopped giving "
                "usable readings (%s) while channel %d was being swept. The "
                "fan is not being lowered any further without it."
                % ("no reading" if temp is None else "%r" % (temp,), channel))
        if temp is not None and temp >= CALIBRATION_ABORT_TEMP:
            raise FanError(
                "aborting calibration: temperature reached %d C (limit %d C)"
                % (temp, CALIBRATION_ABORT_TEMP))
        if stall_started is not None and controller.rpm(channel) == 0:
            stalled_for = time.monotonic() - stall_started
            if stalled_for > CALIBRATION_MAX_STALL_S:
                raise FanError(
                    "aborting calibration: channel %d has been stopped for "
                    "%.0f s (limit %d s); the fan may be seized or the "
                    "tachometer dead" % (channel, stalled_for,
                                         CALIBRATION_MAX_STALL_S))


def command_manual(controller, channel):
    """Put one channel into manual mode for calibration, or abort.

    Calibration owns the duty register for the whole sweep. A chip that did
    not take the manual-mode command is still running its own automatic
    curve, so every duty written afterwards is a suggestion, every RPM read
    back describes the chip's decisions rather than this program's, and the
    numbers that come out the other end are a measurement of nothing.
    """
    if controller.set_manual(channel):
        return
    raise FanError(
        "aborting calibration: channel %d did not accept the manual-mode "
        "command. Nothing was measured and nothing was saved." % channel)


def command_duty(controller, channel, duty, what):
    """Command one calibration duty, or abort.

    In the control loop a refused write is a retry-next-cycle event: the fan
    stays where it is, which is somewhere it was already running. In a
    calibration sweep the next step is *lower*, so continuing after a refusal
    means stepping a fan towards its stall point without knowing what duty it
    is actually on. There is no safe way to do that, so the first refusal
    ends the sweep and the caller hands the fans back.
    """
    if controller.set_pwm(channel, duty):
        return
    raise FanError(
        "aborting calibration: channel %d did not accept the %s duty %d. The "
        "chip is not acknowledging commands, so the fan's real duty is "
        "unknown and the sweep will not step down blind." % (channel, what, duty))


def calibrate_channel(controller, channel, temp_path, settle=3.0, spin=4.0):
    """Measure max RPM, stall duty and restart duty for one channel.

    Returns a raw result dict; the caller decides whether it is trustworthy.
    The caller also owns the safe state - this function only measures.
    """
    log("")
    log("=== calibrating fan%d ===" % channel)
    result = {"stall_duty": None}
    command_manual(controller, channel)

    command_duty(controller, channel, PWM_MAX, "full-speed")
    _settle(controller, channel, spin, temp_path)
    result["max_rpm"] = controller.rpm(channel)
    log("  max RPM at duty %d: %s" % (PWM_MAX, result["max_rpm"]))
    if not result["max_rpm"]:
        log("  no rotation at full duty - nothing to calibrate on this channel")
        return result

    log("  searching stall duty (the fan will stop)...")
    last_spinning = PWM_MAX
    for duty in range(120, CALIBRATION_SWEEP_MIN - 1, -5):
        command_duty(controller, channel, duty, "descending-sweep")
        _settle(controller, channel, settle, temp_path)
        rpm = controller.rpm(channel)
        if rpm > 0:
            last_spinning = duty
            log("    duty %3d: %s RPM" % (duty, rpm))
        else:
            result["stall_duty"] = duty
            log("    duty %3d: STALLED" % duty)
            break
    if result["stall_duty"] is None:
        # The fan never stopped anywhere in the swept range.
        result["stall_duty"] = last_spinning
        log("  never stalled; lowest duty tried was %d and it kept turning"
            % last_spinning)
    result["minstop"] = max(PWM_FLOOR, clamp_pwm(last_spinning + 10))
    log("  lowest spinning duty %d -> minimum %d with margin"
        % (last_spinning, result["minstop"]))

    log("  searching restart duty...")
    stall_started = time.monotonic()
    command_duty(controller, channel, PWM_MIN, "zero")
    _settle(controller, channel, 2, temp_path, stall_started=stall_started)
    minstart = None
    # Start from just below the measured stall point rather than from a fixed
    # low value: the fan is stopped for this entire sweep, so every skipped
    # step is airflow the machine does not have.
    start_duty = max(PWM_FLOOR, clamp_pwm(result["stall_duty"] - 10))
    for duty in range(start_duty, PWM_MAX + 1, 5):
        command_duty(controller, channel, duty, "restart")
        _settle(controller, channel, settle, temp_path,
                stall_started=stall_started)
        if controller.rpm(channel) > 0:
            minstart = duty
            log("    duty %3d: restarted" % duty)
            break
        log("    duty %3d: still stopped" % duty)
    if minstart is None:
        raise FanError("channel %d never restarted, even at full duty" % channel)
    result["minstart"] = max(clamp_pwm(minstart + 10), result["minstop"])
    log("  restart duty %d -> %d with margin" % (minstart, result["minstart"]))

    command_duty(controller, channel, result["minstop"], "final-minimum")
    _settle(controller, channel, settle, temp_path)
    result["min_rpm"] = controller.rpm(channel)
    log("  RPM at duty %d: %s" % (result["minstop"], result["min_rpm"]))

    # Leave the channel cooling before moving to the next one. Gated like
    # every other write here: a chip that will not take full duty at the end
    # of a sweep is one the next channel must not be swept on either.
    command_duty(controller, channel, SAFE_PWM, "cool-down")
    return result


def cmd_calibrate(args):
    require_root()
    device = find_device(args.device_glob)
    controller = FanController(device, dry_run=args.dry_run)

    if not args.yes:
        print(CALIBRATION_WARNING)
        print("Re-run with --yes to confirm you accept the reduced-airflow risk.")
        return 2

    print(CALIBRATION_WARNING)
    temp_path = find_temp_input(args.sensor)
    if temp_path is None and not args.dry_run:
        raise FanError(
            "temperature sensor '%s' not found. Calibration stops the fan and "
            "needs a temperature reading to abort safely; refusing to run "
            "blind." % args.sensor)
    start_temp = read_temp(temp_path)
    if not temperature_is_plausible(start_temp) and not args.dry_run:
        raise FanError("temperature sensor '%s' is unreadable; refusing to run"
                       % args.sensor)
    if start_temp is not None and start_temp > CALIBRATION_START_MAX_TEMP:
        raise FanError(
            "machine is already at %d C (limit %d C). Let it cool down before "
            "calibrating." % (start_temp, CALIBRATION_START_MAX_TEMP))
    log("starting temperature: %s"
        % ("N/A" if start_temp is None else "%d C" % start_temp))

    # Handlers and locks before the first write, not after. The locks are
    # named after the controller, so an operator calibrating with one --cache
    # still contends with the service loop running from another.
    install_signal_handlers()
    locks = acquire_writer_locks(device)

    results = {}
    outcome = "aborted"
    restored = False
    up_to_date = False
    # Opened before the first thing that can write a register and closed after
    # the last one. --probe puts a silent channel into manual mode at full
    # duty in order to find out whether a fan is attached to it, and that is a
    # hardware-mutating calibration action like any other. It used to run in
    # front of this block, with nothing but _Borrowed's unchecked restore()
    # behind it, so a chip that accepted the probe and then refused automatic
    # mode left calibration through one of the two exits below - "nothing is
    # spinning" and "the cache already matches" - having proven nothing and
    # aggregated nothing.
    try:
        existing = None
        try:
            existing = load_cache(args.cache)
        except FanError as exc:
            log("WARN %s - it will be replaced" % exc)

        channels = args.channels or controller.detect_active(probe=args.probe)
        channels = [c for c in channels if controller.controllable(c)]
        if not channels:
            raise FanError(
                "no controllable fan channel is spinning. Use --probe to spin "
                "up silent channels, or --channels to name them explicitly.")
        log("channels to calibrate: %s" % channels)

        if existing and sorted(existing["channels"]) == sorted(channels) \
                and not args.force:
            log("cached calibration already matches channels %s; use --force "
                "to redo" % channels)
            outcome = "not needed"
            up_to_date = True
        else:
            for channel in channels:
                results[channel] = calibrate_channel(controller, channel,
                                                     temp_path)
            outcome = "finished"
    except Terminated as exc:
        outcome = "interrupted by %s" % exc
        raise FanError("calibration interrupted by %s before completion" % exc)
    finally:
        # Runs on success too: a sweep that visited stall duties must never
        # leave the chip in manual mode. The reason is reported accurately so
        # the journal does not claim a clean finish after an interruption.
        # The locks come off in a nested `finally` so that releasing them
        # never depends on safe_state() returning at all.
        try:
            if controller.touched_channels():
                restored = controller.safe_state(
                    reason="calibration %s" % outcome)
                if not restored:
                    # Said here as well as below, because below is only
                    # reached when the sweep itself succeeded. When an abort
                    # is already on its way out, this is the only place the
                    # cleanup failure gets reported.
                    log("ALERT the calibration cleanup could not be confirmed; "
                        "the fans are NOT proven back in the chip's automatic "
                        "mode. Recover with: qnap-tsx70-fancontrol safe-state")
            else:
                # Not one register was written - no probe, no sweep - so there
                # is no handback to prove. Deliberately not routed through
                # safe_state(): "no target" there means a caller asked for a
                # fan to be handed back and got none, which is a failure, and
                # this is not that.
                log("no fan register was written, so there is nothing to hand "
                    "back")
                restored = True
        finally:
            release_locks(locks)
    if not restored:
        # The sweep deliberately parked this fan at duties it does not turn
        # at. Nothing below may run - not the analysis, not the save, and
        # certainly not the "start the service when you are ready" line - on a
        # machine whose fans are in an unknown state.
        raise FanError(
            "calibration ended with channels that could not be confirmed back "
            "in the chip's automatic mode; the results were NOT saved. Restore "
            "the fans first: qnap-tsx70-fancontrol safe-state")
    if up_to_date:
        return finish_or_stop(controller, 0)

    usable, rejected = {}, []
    for channel, result in results.items():
        if calibration_is_degenerate(result):
            rejected.append(channel)
        else:
            usable[channel] = result
    for channel in rejected:
        log("WARN channel %d produced an implausible result and was discarded "
            "(fan not spinning, or tachometer not reporting)" % channel)
    if not usable:
        raise FanError("no channel produced a usable calibration; nothing saved")

    data = validate_cache({"version": 1, "channels": sorted(usable),
                           "fans": {str(c): v for c, v in usable.items()}})
    payload = {"version": 1, "channels": data["channels"],
               "fans": {str(c): v for c, v in data["fans"].items()}}
    if args.dry_run:
        log("dry run: calibration not saved")
    else:
        save_cache(payload, args.cache)
        log("saved calibration to %s" % args.cache)
    for channel, values in sorted(data["fans"].items()):
        log("  fan%s: %s-%s RPM, duty %s-%s, restart at %s"
            % (channel, values["min_rpm"], values["max_rpm"],
               values["minstop"], PWM_MAX, values["minstart"]))
    log("")
    log("Start the service when you are ready: systemctl start qnap-tsx70-fancontrol")
    return finish_or_stop(controller, 0)


def cmd_run(args):
    require_root()
    device = find_device(args.device_glob)
    controller = FanController(device, dry_run=args.dry_run)
    cache = load_cache(args.cache)
    if cache is None:
        raise FanError(
            "no calibration at %s. Run 'qnap-tsx70-fancontrol calibrate --yes' "
            "first; read docs/FAN_CONTROL.md for the hazard notice." % args.cache)

    channels = [c for c in cache["channels"] if controller.controllable(c)]
    missing = sorted(set(cache["channels"]) - set(channels))
    if missing:
        log("WARN calibrated channels not controllable now: %s" % missing)
    if not channels:
        raise FanError("none of the calibrated channels %s exist on %s"
                       % (cache["channels"], device))

    temp_path = find_temp_input(args.sensor)
    if temp_path is None:
        raise FanError("temperature sensor '%s' not found; refusing to run a "
                       "control loop without a temperature input" % args.sensor)

    install_signal_handlers()
    locks = acquire_writer_locks(device)
    log("qnap-tsx70-fancontrol %s starting" % VERSION)
    log("  controller : %s" % device)
    log("  channels   : %s" % channels)
    log("  sensor     : %s" % temp_path)
    log("  curve      : %d-%d C -> calibrated minimum..%d"
        % (args.temp_min, args.temp_max, PWM_MAX))
    log("  interval   : %ds" % args.interval)
    if args.dry_run:
        log("  MODE       : dry run, no register writes")

    running = {c: True for c in channels}
    kickstarts = {c: 0 for c in channels}
    temp_failures = 0
    clean_exit = False
    restored = False
    try:
        # Every channel is attempted before the verdict, so a chip that
        # refuses two of three is reported as refusing two of three and all
        # three are remembered for the safe state. Entering the loop without
        # checking meant a channel still on the chip's own automatic curve was
        # driven for the rest of the run as though this program owned it.
        refused = [c for c in channels if not controller.set_manual(c)]
        if refused:
            raise FanError(
                "channels %s did not accept the manual-mode command, so this "
                "program is not in control of them; refusing to run a curve "
                "against registers the chip is ignoring" % refused)

        while True:
            temp = read_temp(temp_path)
            if temp is None:
                temp_failures += 1
                log("WARN temperature unreadable (%d/%d) - forcing full duty"
                    % (temp_failures, TEMP_FAILURE_LIMIT))
                for channel in channels:
                    controller.set_pwm(channel, SAFE_PWM)
                if temp_failures >= TEMP_FAILURE_LIMIT:
                    raise FanError(
                        "temperature input lost for %d consecutive cycles"
                        % temp_failures)
                time.sleep(args.interval)
                continue
            temp_failures = 0

            for channel in channels:
                values = cache["fans"].get(channel, {})
                minimum = max(PWM_FLOOR, clamp_pwm(values.get("minstop", SAFE_PWM)))
                restart = max(minimum, clamp_pwm(values.get("minstart", SAFE_PWM)))
                target = calc_pwm(temp, minimum, PWM_MAX,
                                  args.temp_min, args.temp_max)
                rpm = controller.rpm(channel)
                if rpm == 0:
                    kickstarts[channel] += 1
                    if kickstarts[channel] >= KICKSTART_LIMIT:
                        raise FanError(
                            "channel %d did not restart after %d attempts; the "
                            "fan may be seized or disconnected"
                            % (channel, kickstarts[channel]))
                    # Escalate rather than re-sending the same duty forever.
                    duty = SAFE_PWM if kickstarts[channel] > 2 else max(target, restart)
                    if running.get(channel, True):
                        log("fan%d not turning at %d C, kickstarting at duty %d"
                            % (channel, temp, duty))
                    controller.set_pwm(channel, duty)
                    running[channel] = False
                else:
                    if not running.get(channel, True):
                        log("fan%d turning again (%s RPM)" % (channel, rpm))
                    running[channel] = True
                    kickstarts[channel] = 0
                    controller.set_pwm(channel, target)

            # Per channel and per register: one fan answering every command
            # is not evidence about the one next to it that answers none.
            exhausted = controller.exhausted_writes(WRITE_FAILURE_LIMIT)
            if exhausted:
                raise FanError(
                    "the controller is not accepting commands: %s. Failing "
                    "safe rather than running a curve against registers that "
                    "refuse it"
                    % "; ".join("%s refused %d consecutive writes"
                                % (register, count)
                                for _, register, count in exhausted))
            time.sleep(args.interval)
    except Terminated as exc:
        log("stopping on %s" % exc)
        clean_exit = True
    finally:
        # Unconditional: covers the clean stop, FanError, and any unexpected
        # exception on the way out. The verdict is kept rather than returned
        # from here, because returning out of a `finally` would swallow the
        # FanError that brought the loop down. The locks come off in a nested
        # `finally` so that releasing them never depends on safe_state()
        # returning at all.
        try:
            restored = controller.safe_state(
                reason="service stopping" if clean_exit else "control loop failed")
        finally:
            release_locks(locks)
    # Reached only on the clean stop; every other path left through `finally`
    # with its own exception. A stop that could not hand the fans back is not
    # a clean stop, whatever the signal said - including a second signal
    # delivered while the safe state was putting the mask back.
    if not restored:
        raise FanError(
            "stopped, but the fans could not be confirmed back in the chip's "
            "automatic mode. Check them now: qnap-tsx70-fancontrol status")
    return finish_or_stop(controller, 0)


def build_parser():
    parser = argparse.ArgumentParser(
        prog="qnap-tsx70-fancontrol",
        description="Experimental chassis fan control for QNAP TS-x70 boards.",
        epilog="Read docs/FAN_CONTROL.md before running calibrate.")
    parser.add_argument("--version", action="version",
                        version="qnap-tsx70-fancontrol %s" % VERSION)

    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--device-glob", default=DEFAULT_DEVICE_GLOB,
                        help="platform device pattern (default: %(default)s)")
    common.add_argument("--cache", default=CACHE_FILE,
                        help="calibration file (default: %(default)s)")
    common.add_argument("--sensor", default="coretemp",
                        help="hwmon driver name for CPU temperature "
                             "(default: %(default)s)")
    common.add_argument("--dry-run", action="store_true",
                        help="never write a register; report what would happen")

    sub = parser.add_subparsers(dest="command", required=True)

    status = sub.add_parser("status", parents=[common],
                            help="report hardware and calibration state")
    status.add_argument("--json", action="store_true",
                        help="machine-readable output")
    status.set_defaults(func=cmd_status)

    calibrate = sub.add_parser(
        "calibrate", parents=[common],
        help="HAZARDOUS: measure stall and restart duty cycles")
    calibrate.add_argument("--yes", action="store_true",
                           help="confirm the reduced-airflow hazard (required)")
    calibrate.add_argument("--force", action="store_true",
                           help="recalibrate even if the cache already matches")
    calibrate.add_argument("--probe", action="store_true",
                           help="also spin up channels that read 0 RPM")
    calibrate.add_argument("--channels", type=int, nargs="+", metavar="N",
                           help="calibrate these channels instead of detecting")
    calibrate.set_defaults(func=cmd_calibrate)

    run_cmd = sub.add_parser("run", parents=[common],
                             help="continuous temperature control loop")
    run_cmd.add_argument("--interval", type=int, default=INTERVAL,
                         help="seconds between iterations (default: %(default)s)")
    run_cmd.add_argument("--temp-min", type=int, default=TEMP_MIN,
                         help="curve lower bound in C (default: %(default)s)")
    run_cmd.add_argument("--temp-max", type=int, default=TEMP_MAX,
                         help="curve upper bound in C (default: %(default)s)")
    run_cmd.set_defaults(func=cmd_run)

    safe = sub.add_parser("safe-state", parents=[common],
                          help="force all channels back to automatic mode")
    safe.set_defaults(func=cmd_safe_state)

    check = sub.add_parser("validate-cache", parents=[common],
                           help="check a calibration cache without touching "
                                "the hardware")
    check.set_defaults(func=cmd_validate_cache)
    return parser


def main(argv=None):
    args = build_parser().parse_args(argv)
    reset_handback_record()
    try:
        code = args.func(args)
    except FanError as exc:
        log("ERROR %s" % exc)
        return 1
    except Terminated as exc:
        # A stop signal is a normal way for this program to end. It is not a
        # normal way to end with a fan in manual mode, and this branch used to
        # be how that happened: safe_state() unmasked the stop signals inside
        # a `finally`, the second one was delivered there, and the exception
        # it raised unwound past the failed verdict to here, where it was
        # reported as a clean stop. The verdict is recorded before the mask
        # comes down precisely so that it is still readable from here.
        if handback_unverified():
            log("ERROR stopped by %s, but the fans were NOT confirmed back in "
                "the chip's automatic mode (%s). Check them now: "
                "qnap-tsx70-fancontrol safe-state" % (exc, handback_detail()))
            return 1
        log("stopped by %s" % exc)
        return 0
    except PermissionError as exc:
        log("ERROR permission denied: %s" % exc)
        return 1
    except OSError as exc:
        if exc.errno == errno.ENOENT:
            log("ERROR missing path: %s" % exc)
            return 1
        raise
    if code == 0 and handback_unverified():
        # Restating the rule over the exit status itself. No current ordering
        # can reach this - every command that runs a safe state raises or
        # returns nonzero on a false verdict of its own - so this is not where
        # the protection lives. It is here so that a new command, or a moved
        # gate, fails closed instead of quietly reporting success on a chip
        # that was never proven back.
        log("ERROR exiting nonzero: the fans were NOT confirmed back in the "
            "chip's automatic mode (%s)" % handback_detail())
        return 1
    return code


if __name__ == "__main__":
    sys.exit(main())
